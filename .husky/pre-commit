# Format and auto-fix staged files before they are committed.
#
# Runs the "lint-staged" block in package.json: prettier --write plus
# eslint --fix on staged js/jsx/ts/tsx, prettier --write on staged
# json/md/yml/yaml. Only staged files are touched, so this stays fast.
#
# Note that this REWRITES files during the commit -- what lands may differ
# from what you staged. The pre-push hook remains the full-repo safety net;
# this just keeps you from reaching it with fixable formatting.
#
# Bypass once with:  git commit --no-verify

pnpm lint-staged || exit 1
